{
  "name": "project-wednesday",
  "version": "0.4.0",
  "description": "Browser orbital simulator: RK4 or adaptive DOP853 propagation with J2-J4, drag (exponential or NRLMSISE-00), SRP, Sun and Moon gravity, burns, SGP4 TLE import, 3D globe, Mercator ground tracks and drift charts.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khandelwalkshitij/project-wednesday.git"
  },
  "bugs": {
    "url": "https://github.com/khandelwalkshitij/project-wednesday/issues"
  },
  "homepage": "https://github.com/khandelwalkshitij/project-wednesday#readme",
  "scripts": {
    "build": "node tools/build-docs.mjs && node scripts/build.mjs",
    "docs": "node tools/build-docs.mjs",
    "serve": "node scripts/serve.mjs",
    "lint": "eslint src scripts tests",
    "test": "npm run test:core && npm run build && npm run test:browser",
    "test:core": "node tests/core/run-all.mjs",
    "test:browser": "node tests/browser/smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "three": "0.128.0",
    "playwright": "1.63.0"
  }
}
